# Password for SYS and SYSTEM.
ORACLE_PASSWORD=changeme

# Oracle version. Uncomment exactly one block (the three values go together).
# After switching: Dev Containers: Rebuild Container (each version keeps its own volume).

# Oracle Database 23ai Free (default, used for the presentation)
ORACLE_IMAGE=gvenzl/oracle-free:23.26.4-slim-faststart
ORACLE_SERVICE=FREEPDB1
ORACLE_VOLUME=23

# Oracle Database 21c XE (amd64 only)
# ORACLE_IMAGE=gvenzl/oracle-xe:21.3.0-slim-faststart
# ORACLE_SERVICE=XEPDB1
# ORACLE_VOLUME=21

# Oracle Database 18c XE (amd64 only; same 12.2 family as 19c, used as 19c proxy)
# ORACLE_IMAGE=gvenzl/oracle-xe:18.4.0-slim-faststart
# ORACLE_SERVICE=XEPDB1
# ORACLE_VOLUME=18
